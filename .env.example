GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
# fallback model, check the exact name in Google AI Studio
GEMINI_MODEL=gemini-3.8-flash

# "graph" = official Instagram API (needs Business/Creator acct + token)
# "instagrapi" = unofficial, can DM any username, risk of ban
INSTAGRAM_MODE=graph
IG_ACCESS_TOKEN=
IG_VERIFY_TOKEN=any-string-you-pick-for-webhook
IG_USERNAME=
IG_PASSWORD=

# true = agent only pretends to send (good for testing the UI)
DRY_RUN=true
